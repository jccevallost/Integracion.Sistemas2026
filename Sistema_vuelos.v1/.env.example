# Variables requeridas por docker-compose.yml
# Copiar a .env y completar antes de ejecutar `docker compose up`

# PostgreSQL / Supabase por dominio
DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?pgbouncer=true&sslmode=require"
AUTH_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=identity&sslmode=require"
CATALOG_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=catalog&sslmode=require"
FLIGHTS_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=catalog&sslmode=require"
BOOKING_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=booking&sslmode=require"
PAYMENTS_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=payments&sslmode=require"
ADMIN_DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=audit&sslmode=require"

# JWT y comunicacion interna
JWT_SECRET=your-256-bit-hex-secret
JWT_ISSUER=vuelos-api
JWT_AUDIENCE=vuelos-client
JWT_EXPIRES_IN=2h
INTERNAL_API_KEY=change-me-in-production

# Event Bus
EVENT_BUS_DRIVER=rabbitmq
RABBITMQ_URL=amqp://guest:guest@rabbitmq:5672
RABBITMQ_EXCHANGE=vuelos.events
RABBITMQ_RETRY_EXCHANGE=vuelos.events.retry
RABBITMQ_DLQ_EXCHANGE=vuelos.events.dlq
RABBITMQ_RETRY_DELAY_MS=5000
RABBITMQ_MAX_RETRIES=3
EVENT_BUS_IDEMPOTENCY_WINDOW=1000

# Entorno
NODE_ENV=production

# URL del frontend web o movil publicado para CORS
FRONTEND_URL=https://tu-frontend.com
