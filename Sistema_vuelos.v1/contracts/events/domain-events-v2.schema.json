{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vuelos.local/contracts/events/domain-events-v2.schema.json",
  "title": "Vuelos Domain Event v2",
  "type": "object",
  "required": [
    "eventId",
    "eventType",
    "eventVersion",
    "occurredAt",
    "producer",
    "payload"
  ],
  "properties": {
    "eventId": {
      "type": "string",
      "format": "uuid"
    },
    "eventType": {
      "type": "string",
      "enum": [
        "ReservationCreated",
        "ReservationCancelled",
        "SeatAssigned",
        "CheckInCompleted",
        "PaymentRegistered",
        "InvoiceIssued",
        "AncillaryAdded"
      ]
    },
    "eventVersion": {
      "type": "integer",
      "const": 1
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "producer": {
      "type": "string",
      "enum": [
        "booking-service",
        "payments-service",
        "admin-service"
      ]
    },
    "correlationId": {
      "type": "string"
    },
    "payload": {
      "oneOf": [
        { "$ref": "#/$defs/reservationCreatedPayload" },
        { "$ref": "#/$defs/reservationCancelledPayload" },
        { "$ref": "#/$defs/seatAssignedPayload" },
        { "$ref": "#/$defs/checkInCompletedPayload" },
        { "$ref": "#/$defs/paymentRegisteredPayload" },
        { "$ref": "#/$defs/invoiceIssuedPayload" },
        { "$ref": "#/$defs/ancillaryAddedPayload" }
      ]
    }
  },
  "$defs": {
    "reservationCreatedPayload": {
      "type": "object",
      "required": ["reservationId", "userId"],
      "properties": {
        "reservationId": { "type": "string", "format": "uuid" },
        "reservationCode": { "type": "string" },
        "userId": { "type": "string", "format": "uuid" },
        "totalAmount": { "type": "number" }
      }
    },
    "reservationCancelledPayload": {
      "type": "object",
      "required": ["reservationId"],
      "properties": {
        "reservationId": { "type": "string", "format": "uuid" },
        "reason": { "type": "string" }
      }
    },
    "seatAssignedPayload": {
      "type": "object",
      "required": ["passengerId", "seatNumber"],
      "properties": {
        "passengerId": { "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" },
        "seatNumber": { "type": "string", "example": "14C" }
      }
    },
    "checkInCompletedPayload": {
      "type": "object",
      "required": ["boardingPassId", "passengerId"],
      "properties": {
        "boardingPassId": { "type": "string", "format": "uuid" },
        "passengerId": { "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" },
        "boardingCode": { "type": "string" }
      }
    },
    "paymentRegisteredPayload": {
      "type": "object",
      "required": ["paymentId", "reservationId"],
      "properties": {
        "paymentId": { "type": "string", "format": "uuid" },
        "reservationId": { "type": "string", "format": "uuid" },
        "amount": { "type": "number" },
        "status": { "type": "string" }
      }
    },
    "invoiceIssuedPayload": {
      "type": "object",
      "required": ["invoiceId"],
      "properties": {
        "invoiceId": { "type": "string", "format": "uuid" },
        "paymentId": { "type": "string", "format": "uuid" },
        "totalAmount": { "type": "number" }
      }
    },
    "ancillaryAddedPayload": {
      "type": "object",
      "required": ["passengerServiceId"],
      "properties": {
        "passengerServiceId": { "type": "string", "format": "uuid" },
        "passengerId": { "type": "string", "format": "uuid" },
        "amount": { "type": "number" }
      }
    }
  }
}
